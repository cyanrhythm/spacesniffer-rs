#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_install:
	install -Dm755 target/release/spacesniffer-rs debian/spacesniffer-rs/usr/bin/spacesniffer-rs
	install -Dm644 resources/icons/icon.svg debian/spacesniffer-rs/usr/share/icons/hicolor/scalable/apps/spacesniffer-rs.svg
	install -Dm644 resources/spacesniffer-rs.desktop debian/spacesniffer-rs/usr/share/applications/spacesniffer-rs.desktop

override_dh_auto_clean:
	cargo clean

override_dh_auto_test:
	echo "skip test"

override_dh_dwz:
	echo "skip dwz"
